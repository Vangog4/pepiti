<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_tinkoff" model="payment.provider">
        <field name="name">Т-Банк (Tinkoff)</field>
        <field name="code">tinkoff</field>
        <field name="state">disabled</field>
        <field name="is_published">False</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="image_128" type="base64" file="payment_tinkoff/static/description/icon.png"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids" eval="[(6, 0, [
                ref('payment.payment_method_card'),
                ref('payment.payment_method_visa'),
                ref('payment.payment_method_mastercard'),
                ref('payment_tinkoff.payment_method_mir'),
            ])]"/>
        <field name="pending_msg" type="html">
            <p>Ожидаем подтверждение оплаты от Т-Банка…</p>
        </field>
        <field name="done_msg" type="html">
            <p>Оплата прошла успешно. Спасибо за заказ в Pepito Pet!</p>
        </field>
        <field name="cancel_msg" type="html">
            <p>Оплата отменена или не завершена. Вы можете попробовать снова.</p>
        </field>
    </record>
</odoo>
